# Database Configuration
DATABASE_URL=postgresql://username:password@host:5432/database_name
# OR use individual PostgreSQL variables:
PGHOST=localhost
PGPORT=5432
PGDATABASE=recycle_app
PGUSER=postgres
PGPASSWORD=your_password

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Email Configuration (Choose ONE method)

# Method 1: Gmail (Recommended for quick setup)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
# How to get Gmail App Password:
# 1. Go to https://myaccount.google.com/
# 2. Security → 2-Step Verification (enable it)
# 3. Security → App passwords
# 4. Create new app password for "Mail"
# 5. Copy the 16-character password and paste above

# Method 2: Custom SMTP (Alternative)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:8081
# In production, use: FRONTEND_URL=https://your-app-domain.com

# Optional: Debug mode
DEBUG=0
